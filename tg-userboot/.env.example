# ==============================================================================
# TG-USERBOOT: Configuration Template
# Author: hzzmonetvn
# ==============================================================================

# Telegram MTProto API Credentials (Get from https://my.telegram.org)
API_ID=2040
API_HASH=b18441a1ff607e10a989891a5462e627

# Command Prefix Triggers
CMD_TRIGGER=.
SUDO_TRIGGER=!

# Session Storage
SESSION_FILE=userbot.session

# Owner and Sudo Access
OWNER_ID=
SUDO_USERS=

# ==============================================================================
# Custom AI Chat Configuration (Universal OpenAI / OneAPI / Ollama / DeepSeek)
# ==============================================================================
# Custom AI API Key
AI_API_KEY=

# Custom AI Base URL (Supports standard /v1 or direct provider endpoints)
# Examples:
#   - OpenAI: https://api.openai.com/v1
#   - OpenRouter: https://openrouter.ai/api/v1
#   - DeepSeek: https://api.deepseek.com/v1
#   - Groq: https://api.groq.com/openai/v1
#   - Local Ollama: http://localhost:11434/v1
#   - Custom Proxy / OneAPI / NewAPI: https://your-custom-domain.com/v1
AI_BASE_URL=https://api.openai.com/v1

# Custom AI Chat Model Name
# Examples: gpt-4o-mini, deepseek-chat, deepseek-reasoner, gemini-2.0-flash, claude-3-5-sonnet
AI_MODEL=gpt-4o-mini

# Custom AI System Instructions
AI_SYSTEM_PROMPT=You are a helpful and concise Telegram AI assistant.

# Backward-compatibility fallback: Google Gemini direct key
GEMINI_API_KEY=

# ==============================================================================
# Custom AI Image Generation Configuration (.img, .genimg, .imagine)
# ==============================================================================
# Image Generation API Key (Leave empty to inherit AI_API_KEY)
IMAGE_API_KEY=

# Image Generation Base URL (Leave empty to inherit AI_BASE_URL)
IMAGE_BASE_URL=https://api.openai.com/v1

# Custom Image Model Name
# Examples: dall-e-3, dall-e-2, flux, stable-diffusion-3
IMAGE_MODEL=dall-e-3

# ==============================================================================
# Third-Party Utility APIs
# ==============================================================================
# OpenWeatherMap API Key (Optional, wttr.in is used as reliable primary/fallback)
WEATHER_API=
CITY=Hanoi

# Optional Logging Channel ID (-100...)
LOG_CHAT=

# Developer Mode (1 to enable raw execution logs)
DEV_MODE=0
