# ============================================================
# Cấu hình Telegram Userbot (lấy tại https://my.telegram.org)
# Mặc định sử dụng API ID và API HASH công khai của Telegram Android
# ============================================================
API_ID=2040
API_HASH=b18441a1ff607e10a989891a5462e627

# Session string (nếu đã có session string, không cần đăng nhập lại số điện thoại)
SESSION_STRING=

# Tên file session sqlite (khi không dùng SESSION_STRING, mặc định: bot)
SESSION_NAME=bot

# ============================================================
# Cấu hình Helper Bot (tùy chọn, tạo bot tại https://t.me/BotFather)
# Dùng để điều khiển cập nhật tên & bio bằng các nút bấm trên Telegram
# ============================================================
BOT_TOKEN=
ADMIN_ID=

# ============================================================
# Cấu hình Thời Tiết OpenWeatherMap (https://openweathermap.org)
# Để trống nếu không dùng API thời tiết (sẽ chỉ hiện tên thành phố)
# ============================================================
WEATHER_API=
CITY=Bac Ninh

# ============================================================
# Cấu hình Âm Nhạc Last.fm (https://www.last.fm)
# Hỗ trợ Spotify, Apple Music, YouTube Music...
# API Key mặc định đã có sẵn, chỉ cần nhập Last.fm Username
# ============================================================
LASTFM_USERNAME=
LASTFM_API_KEY=b25b959554ed76058ac220b7b2e0a026

# ============================================================
# Cấu hình hiển thị Profile Telegram
# ============================================================
BASE_NAME=HzzMonet
TIMEZONE=Asia/Ho_Chi_Minh
# Ngôn ngữ hiển thị (Language): vi (Tiếng Việt) hoặc en (English)
LANGUAGE=vi
# Mẫu hiển thị tên (Hỗ trợ: {base_name}, HH, mm, ss, DD, MM, YYYY, {thu}, {day}, {city}, {music}, {music_or_weather})
NAME_FORMAT={base_name} | HH:mm - DD/MM/YYYY
BIO_FORMAT={music_or_weather} ⏰ HH:mm

# ============================================================
# Cấu hình AI Chat & Image (OpenAI / OpenRouter / DeepSeek / Ollama / Gemini)
# ============================================================
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_SYSTEM_PROMPT=You are a helpful and concise Telegram AI assistant.
GEMINI_API_KEY=

IMAGE_API_KEY=
IMAGE_BASE_URL=https://api.openai.com/v1
IMAGE_MODEL=dall-e-3

